{
  "id": "3ebf5eaf-bd81-411c-b452-515e4d92530e",
  "version": "1.9",
  "name": "EmailTriage",
  "runtime": "maestro",
  "nodes": [
    {
      "id": "start",
      "type": "core.trigger.manual",
      "typeVersion": "1.0",
      "display": {
        "label": "Manual trigger",
        "icon": "play"
      },
      "inputs": {
        "entryPointId": "d2a2ab88-7340-4c16-b86d-13406dfdd9b7",
        "isDefaultEntryPoint": true
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Data passed when manually triggering the process.",
          "source": "null",
          "var": "output"
        }
      }
    },
    {
      "id": "end1",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End",
        "icon": "circle-check"
      },
      "inputs": {},
      "outputs": {
        "category": {
          "type": "string",
          "source": "{{ $vars.agent_triage.output.category }}"
        },
        "urgencyScore": {
          "type": "number",
          "source": "=js:$vars.agent_triage.output.urgencyScore"
        },
        "requiresEscalation": {
          "type": "boolean",
          "source": "=js:$vars.agent_triage.output.requiresEscalation"
        },
        "actionItems": {
          "type": "array",
          "source": "=js:$vars.agent_triage.output.actionItems"
        },
        "reviewOutcome": {
          "type": "string",
          "source": "{{ $vars.triageReview1.status }}"
        },
        "reviewerNote": {
          "type": "string",
          "source": "{{ $vars.triageReview1.output.feedback }}"
        },
        "confidence": {
          "type": "number",
          "source": "=js:$vars.agent_triage.output.confidence"
        },
        "reasoning": {
          "type": "string",
          "source": "{{ $vars.agent_triage.output.reasoning }}"
        },
        "canAutoResolve": {
          "type": "boolean",
          "source": "=js:$vars.agent_triage.output.canAutoResolve"
        },
        "replyText": {
          "type": "string",
          "source": "{{ $vars.agent_triage.output.replyText }}"
        }
      }
    },
    {
      "id": "agent_triage",
      "type": "uipath.agent.autonomous",
      "typeVersion": "1.4",
      "display": {
        "label": "Triage AI Agent",
        "icon": "autonomous-agent"
      },
      "inputs": {
        "systemPrompt": "Customer Support Triage AI (canonical prompt lives in agent.json)",
        "userPrompt": "Triage this email: {{ $vars.start.output.emailBody }}",
        "model": "gpt-4o-2024-11-20",
        "mode": "standard",
        "agentInputVariables": [
          {
            "id": "start__output__emailBody",
            "type": "string",
            "binding": "=$vars.start.output.emailBody"
          }
        ],
        "agentOutputVariables": [
          {
            "id": "category",
            "type": "string"
          },
          {
            "id": "urgencyScore",
            "type": "number"
          },
          {
            "id": "requiresEscalation",
            "type": "boolean"
          },
          {
            "id": "actionItems",
            "type": "array"
          },
          {
            "id": "confidence",
            "type": "number"
          },
          {
            "id": "reasoning",
            "type": "string"
          },
          {
            "id": "canAutoResolve",
            "type": "boolean"
          },
          {
            "id": "replyText",
            "type": "string"
          }
        ],
        "source": "7269ed1a-4ac2-480e-9fdd-6c906a2a5eda"
      },
      "outputs": {
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "schema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "required": [
              "code",
              "message",
              "detail",
              "category",
              "status"
            ],
            "properties": {
              "code": {
                "type": "string",
                "description": "Error code as a string"
              },
              "message": {
                "type": "string",
                "description": "High-level error message"
              },
              "detail": {
                "type": "string",
                "description": "Detailed error description"
              },
              "category": {
                "type": "string",
                "description": "Error category"
              },
              "status": {
                "type": "integer",
                "description": "HTTP status code"
              }
            },
            "additionalProperties": false
          },
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "organizationindex1",
      "type": "uipath.agent.resource.context.index.organizationindex.<your-organizationindex-id>",
      "typeVersion": "1.0.0",
      "display": {
        "label": "OrganizationIndex",
        "icon": "context"
      },
      "inputs": {
        "indexId": "<your-organizationindex-id>",
        "indexName": "OrganizationIndex",
        "folderKey": "<your-tutorialsolution-folder-key>",
        "folderPath": "TutorialSolution",
        "retrievalMode": "semantic",
        "query": {
          "mode": "prompt",
          "textValue": "",
          "promptValue": "The query for the Semantic strategy",
          "argumentPath": ""
        },
        "threshold": 0,
        "resultCount": 3,
        "fileExtension": "All",
        "folderPathPrefix": {
          "mode": "text-builder",
          "textValue": "",
          "promptValue": "",
          "argumentPath": ""
        },
        "citations": "enabled",
        "outputColumns": [],
        "webSearchGrounding": {
          "value": "enabled"
        },
        "source": "45f558d3-c31e-4f67-91c2-3a3539fd96b8"
      }
    },
    {
      "id": "triageReview1",
      "type": "uipath.human-in-the-loop.quick-form",
      "typeVersion": "1.1",
      "display": {
        "label": "Triage Review",
        "icon": "users"
      },
      "inputs": {
        "type": "quick",
        "schema": {
          "id": "5f2197e6-ab6e-4724-970c-b2a110b73060",
          "fields": [
            {
              "id": "emailbody",
              "label": "Customer email",
              "type": "string",
              "direction": "input",
              "binding": "=js:$vars.start.output.emailBody"
            },
            {
              "id": "ticketid",
              "label": "Ticket id",
              "type": "string",
              "direction": "input",
              "binding": "=js:$vars.start.output.ticketId"
            },
            {
              "id": "department",
              "label": "Department the agent proposed",
              "type": "string",
              "direction": "input",
              "binding": "=js:$vars.agent_triage.output.category"
            },
            {
              "id": "urgency",
              "label": "Urgency (1-5)",
              "type": "string",
              "direction": "input",
              "binding": "=js:String($vars.agent_triage.output.urgencyScore)"
            },
            {
              "id": "confidence",
              "label": "Confidence (0-100)",
              "type": "string",
              "direction": "input",
              "binding": "=js:String($vars.agent_triage.output.confidence)"
            },
            {
              "id": "reasoning",
              "label": "Reasoning",
              "type": "string",
              "direction": "input",
              "binding": "=js:$vars.agent_triage.output.reasoning"
            },
            {
              "id": "feedback",
              "label": "Feedback (why you corrected or denied)",
              "type": "string",
              "direction": "output",
              "variable": "feedback"
            },
            {
              "id": "correcteddepartment",
              "label": "Corrected department (Modify only)",
              "type": "string",
              "direction": "output",
              "variable": "correctedDepartment"
            }
          ],
          "outcomes": [
            {
              "id": "approve",
              "name": "Approve",
              "type": "string",
              "isPrimary": true,
              "action": "Continue"
            },
            {
              "id": "modify",
              "name": "Modify",
              "type": "string",
              "isPrimary": false,
              "action": "End"
            },
            {
              "id": "deny",
              "name": "Deny",
              "type": "string",
              "isPrimary": false,
              "action": "End"
            }
          ],
          "schemaId": "d7c054a9-4297-42b4-80aa-c7762d22cdff"
        },
        "recipient": {
          "channels": [
            "Email",
            "ActionCenter"
          ],
          "connections": {},
          "assignee": {
            "type": "staticEmail",
            "value": "reviewer@example.com"
          }
        },
        "title": "Triage Review",
        "priority": "Medium",
        "assignee": {
          "type": "user",
          "value": "reviewer@example.com",
          "displayName": "Johannes Reitermayer"
        }
      },
      "outputs": {
        "output": {
          "type": "object",
          "source": "=result",
          "var": "output",
          "description": "Task result data"
        },
        "status": {
          "type": "string",
          "source": "=result.Action",
          "var": "status",
          "description": "Task completion outcome"
        }
      }
    },
    {
      "id": "createEntityRecord1",
      "type": "uipath.connector.uipath-uipath-dataservice.create-entity-record",
      "typeVersion": "1.0.0",
