    {
      "id": "queryEntityRecords1",
      "type": "uipath.agent.resource.tool.connector.uipath-uipath-dataservice.query-entity-records",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Query Entity Records",
        "description": "Earlier triage decisions from the TriageDecision entity. Each record is an email that was routed by this process and confirmed (Outcome 1), corrected (Outcome 2) or denied (Outcome 3) by a human reviewer. Outcome 0 and 4 rows were not reviewed and are not precedent.",
        "icon": "https://cloud.uipath.com/<your-org-id>/studio_/typecache/icons/98381fa079bbcf73264f551006d6ef7580fb53992f3d9f94361eb5d9e06040cb.svg"
      },
      "inputs": {
        "source": "783cd9cb-09a2-4563-b3a1-201200e8af63",
        "detail": {
          "connector": "uipath-uipath-dataservice",
          "connectionId": "<your-dataservice-connection-id>",
          "connectionResourceId": "<your-dataservice-connection-id>",
          "connectionFolderKey": "<your-personal-workspace-folder-key>",
          "method": "POST",
          "endpoint": "/v2/{entityName}/qer",
          "bodyParameters": {},
          "queryParameters": {
            "limit": 100,
            "expansionLevel": 1,
            "isAscending": false,
            "start": 0
          },
          "pathParameters": {
            "entityName": "TriageDecision"
          },
          "uiPathActivityTypeId": "703065b9-a310-33b8-9d4d-12df0a6f520b",
          "errorState": {
            "issues": []
          },
          "configuration": "=jsonString:{\"essentialConfiguration\":{\"connectorVersion\":\"1.73.0\",\"customFieldsRequestDetails\":{\"objectActionName\":\"GenerateSchema\",\"parameterValues\":[[\"entityName\",\"TriageDecision\"]]},\"instanceParameters\":{\"connectorKey\":\"uipath-uipath-dataservice\",\"objectName\":\"QueryEntityRecordsCurated\",\"httpMethod\":\"POST\",\"activityType\":\"Curated\",\"version\":\"1.0.0\",\"supportsStreaming\":false,\"subType\":\"standard\"},\"objectName\":\"QueryEntityRecordsCurated\",\"operation\":\"list\",\"packageVersion\":\"1.0.0\",\"httpMethod\":\"POST\",\"path\":\"/v2/{entityName}/qer\",\"unifiedTypesCompatible\":true}}",
          "inputMetadata": {
            "operation": "list",
            "pagination": {
              "maxPageSize": 1000
            }
          }
        }
      }
    },
    {
      "id": "decision1",
      "type": "core.logic.decision",
      "typeVersion": "1.3",
      "display": {
        "label": "Confident and not Required?",
        "icon": "trending-up-down"
      },
      "inputs": {
        "trueLabel": "Auto-route",
        "falseLabel": "Human review",
        "expression": "=js:$vars.agent_triage.output.confidence > 90 && $vars.agent_triage.output.requiresEscalation === false"
      }
    },
    {
      "id": "createEntityRecord4",
      "type": "uipath.connector.uipath-uipath-dataservice.create-entity-record",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Write row: Auto",
        "icon": "https://cloud.uipath.com/<your-org-id>/studio_/typecache/icons/98381fa079bbcf73264f551006d6ef7580fb53992f3d9f94361eb5d9e06040cb.svg"
      },
      "inputs": {
        "detail": {
          "connector": "uipath-uipath-dataservice",
          "connectionId": "<your-dataservice-connection-id>",
          "connectionResourceId": "<your-dataservice-connection-id>",
          "connectionFolderKey": "<your-personal-workspace-folder-key>",
          "method": "POST",
          "endpoint": "/v2/{entityName}/CreateEntityRecord",
          "bodyParameters": {
            "TicketId": "{{ $vars.start.output.ticketId }}",
            "Phase": "=js:$vars.start.output.phase",
            "EmailBody": "{{ $vars.start.output.emailBody }}",
            "ProposedDepartment": "{{ $vars.agent_triage.output.category }}",
            "Department": "{{ $vars.agent_triage.output.category }}",
            "Outcome": 0,
            "Confidence": "=js:$vars.agent_triage.output.confidence",
            "HumanReviewRequired": "=js:$vars.agent_triage.output.requiresEscalation",
            "Reasoning": "{{ $vars.agent_triage.output.reasoning }}"
          },
          "pathParameters": {
            "entityName": "TriageDecision"
          },
          "uiPathActivityTypeId": "dfd2bc7a-ca4b-3316-8a1f-57c9e106dfbf",
          "errorState": {
